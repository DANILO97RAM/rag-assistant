# ==================================================
# Configuración ChromaDB (Docker)
# ==================================================
# Host y puerto donde corre ChromaDB Server
# Ejecutar antes: docker-compose up -d

CHROMA_HOST=localhost
CHROMA_PORT=8000

# ==================================================
# Configuración API REST
# ==================================================
# Puerto para el servidor FastAPI (cambió de 8000 a 9000)

API_HOST=0.0.0.0
API_PORT=9000

# ==================================================
# Configuración n8n (Workflow Automation)
# ==================================================
# Credenciales para acceder a n8n UI
# URL: http://localhost:5678

N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123
N8N_PORT=5678

# ==================================================
# Entorno
# ==================================================

ENVIRONMENT=development
GEMINI_API_KEY=XXXXX
