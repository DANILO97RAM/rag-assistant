# ========================================
# CONFIGURACIÓN RAG ASSISTANT - BANCOLOMBIA
# ========================================

# Ruta a la base de datos ChromaDB
# Default: data/chroma_db (relativo a la raíz del proyecto)
CHROMA_PATH=data/chroma_db

# ========================================
# API KEYS (si usas modelos externos)
# ========================================

# OpenAI API Key (opcional - para embeddings o LLM)
# OPENAI_API_KEY=sk-...

# Anthropic API Key (opcional - para Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key (opcional)
# GOOGLE_API_KEY=...

# ========================================
# CONFIGURACIÓN DE SCRAPING
# ========================================

# URL base para scraping
SCRAPING_URL=https://www.bancolombia.com/personas

# Profundidad de crawling
SCRAPING_DEPTH=2

# Máximo de páginas a scrapear
SCRAPING_MAX_PAGES=50

# Concurrencia (workers paralelos)
SCRAPING_CONCURRENCY=8

# ========================================
# CONFIGURACIÓN DE CHUNKING
# ========================================

# Tamaño de chunks en tokens
CHUNKS_SIZE=1024

# Overlap entre chunks
CHUNKS_OVERLAP=128

# ========================================
# SERVIDOR MCP
# ========================================

# Puerto para servidor MCP (si se implementa SSE)
# MCP_PORT=3000

# Modo de transporte (stdio, sse)
# MCP_TRANSPORT=stdio

# ========================================
# LOGGING
# ========================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
